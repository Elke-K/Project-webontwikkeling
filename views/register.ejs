<%- include("./partials/header") %>

<main
  class="min-h-screen bg-gray-100 flex items-center justify-center p-6 relative"
>
  <div class="bg-white rounded-2xl shadow-xl overflow-hidden w-full max-w-md">
    <div class="p-6">
      <% if (message) { %>
        <div id="flashMessage" class="mb-4 bg-pink-50 border border-pink-200 text-pink-800 rounded-xl px-4 py-3 text-center flex items-center gap-3 transition-opacity duration-700 opacity-0">
          <span class="text-2xl">🐾</span>
          <div class="text-sm font-medium"><%= message.message %></div>
        </div>
      <% } %>
      <h1 class="text-2xl font-bold text-gray-900 mb-1">Registreren</h1>
      <p class="text-xs text-gray-400 font-mono mb-5">Maak een account aan</p>

      <form action="/register" method="POST" class="space-y-4">
        <div>
          <label class="text-xs text-gray-400 uppercase font-semibold"
            >Gebruikersnaam</label
          >
          <input
            name="username"
            type="text"
            required
            class="mt-1 w-full border border-gray-200 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-300"
          />
        </div>

        <div>
          <label class="text-xs text-gray-400 uppercase font-semibold"
            >Wachtwoord</label
          >
          <input
            id="passwordReg"
            name="password"
            type="password"
            required
            class="mt-1 w-full border border-gray-200 rounded-lg px-4 py-2 focus:outline-none focus:ring-2 focus:ring-gray-300"
          />
        </div>

        <div class="flex items-center justify-between">
          <label class="flex items-center gap-2 text-sm text-gray-600">
            <input type="checkbox" id="showPasswordReg" class="w-4 h-4" />
            Toon wachtwoord
          </label>
          <a href="/login" class="text-sm text-gray-600 hover:underline"
            >Heb je al een account? Inloggen</a
          >
        </div>

        <button
          type="submit"
          class="w-full bg-blue-700 text-white text-sm font-semibold py-2 rounded-xl hover:bg-blue-500 transition"
        >
          Registreer
        </button>
      </form>
    </div>
  </div>
</main>

<script>
  (function () {
    const cb = document.getElementById("showPasswordReg");
    const pwd = document.getElementById("passwordReg");
    if (cb && pwd) {
      cb.addEventListener("change", () => {
        pwd.type = cb.checked ? "text" : "password";
      });
    }
  })();
</script>

<script>
  (function () {
    const flash = document.getElementById('flashMessage');
    if (!flash) return;
    requestAnimationFrame(() => { setTimeout(() => flash.classList.remove('opacity-0'), 10); });
    setTimeout(() => {
      flash.classList.add('opacity-0');
      flash.addEventListener('transitionend', () => flash.remove(), { once: true });
    }, 3200);
  })();
</script>

<%- include('./partials/footer') %>
