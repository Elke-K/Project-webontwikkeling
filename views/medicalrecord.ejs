<%- include("./partials/header") %>

<main class="min-h-screen bg-gray-100 flex items-center justify-center p-6">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden w-full max-w-md">

        <div class="relative">
            <img src="<%=animal.imageUrl%>" alt="medisch dossier" class="w-full h-72 object-cover">
            <div class="absolute top-3 right-3 flex gap-2">
                <span class="bg-white text-gray-700 text-xs font-mono font-bold px-3 py-1 rounded-full shadow"><%=animal.medicalRecord.id%></span>
                <% if(animal.medicalRecord.isSterilized) { %>
                    <span class="bg-green-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow">Gesteriliseerd</span>
                <% } else { %>
                    <span class="bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow">Niet gesteriliseerd</span>
                <% } %>
            </div>
        </div>

        <div class="p-6">
            <h1 class="text-2xl font-bold text-gray-900 mb-1">Medisch Dossier</h1>
            <p class="text-xs text-gray-400 font-mono mb-5"><%=animal.medicalRecord.chipNumber%></p>

            <div class="grid grid-cols-2 gap-3 mb-3">
                <div class="bg-gray-50 rounded-xl p-3">
                    <p class="text-xs text-gray-400 uppercase font-semibold">Bloedgroep</p>
                    <p class="text-gray-800 font-bold"><%=animal.medicalRecord.bloodType%></p>
                </div>
                <div class="bg-gray-50 rounded-xl p-3">
                    <p class="text-xs text-gray-400 uppercase font-semibold">Laatste Vaccinatie</p>
                    <p class="text-gray-800 font-bold"><%=animal.medicalRecord.lastVaccination%></p>
                </div>
            </div>

            <div class="bg-yellow-50 border border-yellow-200 rounded-xl p-3 mb-6">
                <p class="text-xs text-yellow-600 uppercase font-semibold mb-1">Gezondheidsnotitie</p>
                <p class="text-gray-700 text-sm"><%=animal.medicalRecord.healthNote%></p>
            </div>

            <a href="/medical_records" class="block text-center bg-gray-900 text-white text-sm font-semibold py-2 rounded-xl hover:bg-gray-700 transition">
                ← Terug naar alle medische dossiers
            </a>
            <a href="/animal/<%=animal.id%>" class="mt-3 block text-center bg-blue-700 text-white text-sm font-semibold py-2 rounded-xl hover:bg-blue-500 transition">
                Laat dier info zien van dossier <%=animal.medicalRecord.id%>
            </a>
        </div>
    </div>
</main>
<%- include('./partials/footer') %>