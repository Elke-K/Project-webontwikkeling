<%- include("./partials/header") %>
<main class="min-h-screen bg-gray-100 flex items-center justify-center p-6">
    <div class="bg-white rounded-2xl shadow-xl overflow-hidden w-full max-w-md">

        <div class="relative">
            <img src="<%=animal.imageUrl%>" alt="<%=animal.name%>" class="w-full h-72 object-cover">
            <% if (user.role === "ADMIN") { %>
                <a href="/animal/<%=animal.id%>/update" class="absolute top-3 left-3 bg-white bg-opacity-80 rounded-full p-2 shadow hover:bg-gray-200 transition" title="Bewerken">
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="1.5" stroke="currentColor" class="size-6">
                        <path stroke-linecap="round" stroke-linejoin="round" d="M9.594 3.94c.09-.542.56-.94 1.11-.94h2.593c.55 0 1.02.398 1.11.94l.213 1.281c.063.374.313.686.645.87.074.04.147.083.22.127.325.196.72.257 1.075.124l1.217-.456a1.125 1.125 0 0 1 1.37.49l1.296 2.247a1.125 1.125 0 0 1-.26 1.431l-1.003.827c-.293.241-.438.613-.43.992a7.723 7.723 0 0 1 0 .255c-.008.378.137.75.43.991l1.004.827c.424.35.534.955.26 1.43l-1.298 2.247a1.125 1.125 0 0 1-1.369.491l-1.217-.456c-.355-.133-.75-.072-1.076.124a6.47 6.47 0 0 1-.22.128c-.331.183-.581.495-.644.869l-.213 1.281c-.09.543-.56.94-1.11.94h-2.594c-.55 0-1.019-.398-1.11-.94l-.213-1.281c-.062-.374-.312-.686-.644-.87a6.52 6.52 0 0 1-.22-.127c-.325-.196-.72-.257-1.076-.124l-1.217.456a1.125 1.125 0 0 1-1.369-.49l-1.297-2.247a1.125 1.125 0 0 1 .26-1.431l1.004-.827c.292-.24.437-.613.43-.991a6.932 6.932 0 0 1 0-.255c.007-.38-.138-.751-.43-.992l-1.004-.827a1.125 1.125 0 0 1-.26-1.43l1.297-2.247a1.125 1.125 0 0 1 1.37-.491l1.216.456c.356.133.751.072 1.076-.124.072-.044.146-.086.22-.128.332-.183.582-.495.644-.869l.214-1.28Z" />
                        <path stroke-linecap="round" stroke-linejoin="round" d="M15 12a3 3 0 1 1-6 0 3 3 0 0 1 6 0Z" />
                    </svg>

                </a>
            <% } %>

            <div class="absolute top-3 right-3">
                <% if(animal.isActive) { %>
                    <span class="bg-green-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow">Actief</span>
                <% } else { %>
                    <span class="bg-red-500 text-white text-xs font-bold px-3 py-1 rounded-full shadow">Niet actief</span>
                <% } %>
            </div>
        </div>

        <div class="p-6">
            <div class="flex items-center justify-between mb-1">
                <h1 class="text-2xl font-bold text-gray-900"><%=animal.name%></h1>
                <span class="text-xs text-gray-400 font-mono"><%=animal.id%></span>
            </div>
            <p class="text-gray-500 text-sm mb-1"><%=animal.species%></p>
            <p class="text-gray-600 text-sm mb-5"><%=animal.description%></p>

            <div class="grid grid-cols-2 gap-3 mb-5">
                <div class="bg-gray-50 rounded-xl p-3">
                    <p class="text-xs text-gray-400 uppercase font-semibold">Leeftijd</p>
                    <p class="text-gray-800 font-bold"><%=animal.age%> jaar</p>
                </div>
                <div class="bg-gray-50 rounded-xl p-3">
                    <p class="text-xs text-gray-400 uppercase font-semibold">Geboortedatum</p>
                    <p class="text-gray-800 font-bold"><%=animal.birthDate%></p>
                </div>
            </div>

            <div>
                <p class="text-xs text-gray-400 uppercase font-semibold mb-2">Hobbies</p>
                <div class="flex flex-wrap gap-2">
                    <% for(let hobby of animal.hobbies) { %>
                        <span class="bg-blue-100 text-blue-700 border border-blue-200 text-xs font-semibold px-3 py-1 rounded-full">
                            <%=hobby%>
                        </span>
                    <% } %>
                </div>
            </div>

            <a href="/" class="mt-6 block text-center bg-gray-900 text-white text-sm font-semibold py-2 rounded-xl hover:bg-gray-700 transition">
                ← Terug naar alle dieren
            </a>
            <a href="/medicalrecord/<%=animal.medicalRecord.id%>" class="mt-3 block text-center bg-blue-700 text-white text-sm font-semibold py-2 rounded-xl hover:bg-blue-500 transition">
                Laat medisch record zien van <%=animal.name%>
            </a>
        </div>
    </div>
</main>
<%- include('./partials/footer') %>