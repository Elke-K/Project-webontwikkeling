<%- include("./partials/header") %>
<main class="min-h-screen bg-gray-100 flex items-center justify-center p-6">
	<div class="bg-white rounded-2xl shadow-xl overflow-hidden w-full max-w-md">
		<form action="/animal/<%=animal.id%>/update" method="POST" class="p-6">
			<h1 class="text-2xl font-bold text-gray-900 mb-6">Dier bijwerken</h1>
			<div class="mb-4">
				<label for="name" class="block text-gray-700 font-semibold mb-1">Naam</label>
				<input type="text" id="name" name="name" value="<%=animal.name%>" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />
			</div>
			<div class="mb-4">
				<label for="species" class="block text-gray-700 font-semibold mb-1">Soort</label>
				<input type="text" id="species" name="species" value="<%=animal.species%>" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />
			</div>
			<div class="mb-4">
				<label for="description" class="block text-gray-700 font-semibold mb-1">Beschrijving</label>
				<textarea id="description" name="description" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400"><%=animal.description%></textarea>
			</div>
			<div class="mb-4">
				<label for="age" class="block text-gray-700 font-semibold mb-1">Leeftijd</label>
				<input type="number" id="age" name="age" value="<%=animal.age%>" min="0" max="100" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />
			</div>
			<div class="mb-4">
				<label for="birthDate" class="block text-gray-700 font-semibold mb-1">Geboortedatum</label>
				<input type="date" id="birthDate" name="birthDate" value="<%=animal.birthDate%>" required class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />
			</div>
			<div class="mb-4">
				<label for="imageUrl" class="block text-gray-700 font-semibold mb-1">Afbeelding URL</label>
				<input type="url" id="imageUrl" name="imageUrl" value="<%=animal.imageUrl%>" required pattern="https?://.+" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />
			</div>
			<div class="mb-4">
				<label for="hobbies" class="block text-gray-700 font-semibold mb-1">Hobby's <span class="text-xs text-gray-400">(gescheiden door komma's)</span></label>
				<input type="text" id="hobbies" name="hobbies" value="<%=animal.hobbies ? animal.hobbies.join(', ') : ''%>" placeholder="zwemmen, rennen, slapen" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400" />
			</div>
			<div class="mb-4">
				<label for="isActive" class="block text-gray-700 font-semibold mb-1">Actief</label>
				<select id="isActive" name="isActive" class="w-full border border-gray-300 rounded-lg px-3 py-2 focus:outline-none focus:ring-2 focus:ring-blue-400">
					<option value="true" <%= animal.isActive ? 'selected' : '' %>>Ja</option>
					<option value="false" <%= !animal.isActive ? 'selected' : '' %>>Nee</option>
				</select>
			</div>
			<button type="submit" class="w-full bg-blue-700 text-white font-semibold py-2 rounded-xl hover:bg-blue-500 transition">Opslaan</button>
			<a href="/animal/<%=animal.id%>" class="mt-3 block text-center bg-gray-200 text-gray-700 text-sm font-semibold py-2 rounded-xl hover:bg-gray-300 transition">Annuleren</a>
		</form>
	</div>
</main>
<%- include('./partials/footer') %>
